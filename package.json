{
  "name": "comb-extension",
  "version": "0.5.0",
  "private": true,
  "description": "Privacy-first, creator-respecting local coupon tester",
  "scripts": {
    "demo": "node scripts/serve-demo.js",
    "feed:example": "node scripts/create-example-feed-payload.js",
    "feed:keygen": "node scripts/generate-feed-keypair.js",
    "feed:sign": "node scripts/sign-feed.js",
    "feed:verify": "node scripts/verify-feed.js",
    "lint": "node scripts/validate-extension.js && node scripts/validate-store.js",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/run-browser-fixtures.js",
    "release:runtime": "node scripts/build-release.js --verify",
    "release:build": "node scripts/build-store-package.js --verify",
    "check": "npm run lint && npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
